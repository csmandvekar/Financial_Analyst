{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": 2,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Circuit Breaker State (0=Closed, 1=Open, 2=Half-Open)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "circuit_breaker_state",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "title": "Cache Hit vs Miss Rate",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(cache_hit_total[5m])) by (cache_key_prefix)",
          "legendFormat": "Hits: {{cache_key_prefix}}"
        },
        {
          "expr": "sum(rate(cache_miss_total[5m])) by (cache_key_prefix)",
          "legendFormat": "Misses: {{cache_key_prefix}}"
        }
      ]
    },
    {
      "title": "External API Call Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(external_api_call_duration_seconds_bucket[5m])) by (le, source))",
          "legendFormat": "{{source}} (p95)"
        }
      ]
    },
    {
      "title": "External API Call Rate by Status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "sum(rate(external_api_call_total[5m])) by (source, status)",
          "legendFormat": "{{source}} ({{status}})"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["datasources", "cache", "resilience"],
  "time": { "from": "now-1h", "to": "now" },
  "title": "Data Source Health & Resilience",
  "uid": "datasource-health-v1",
  "version": 1
}
